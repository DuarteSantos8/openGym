// The phone the simulator build plays with SIM_PHONE (sim/gen.mjs copies this to
// sim/source/SimPhone.mc then, and a stub otherwise, so sim/run.sh long measures the app alone).
// SIM_PHONE=1: the phone started a workout; SIM_PHONE=start: it starts the one the watch starts.
// Every 2 s the watch's new events go to its copy of the whole workout (a set done, a rest
// changed, the end), and the snapshot comes back the way lib/watch-sync.js and
// lib/garmin-snapshot.js make it: the window (the exercise up now, its superset, the block after),
// `acked`, the rest and its stamp, numbers with a fraction as Doubles (the Android bridge's Java
// Double). What arrives goes through the app's own path (OpenGymApp.took), as a phone's message.
import Toybox.Application;
import Toybox.Lang;
import Toybox.System;

(:sim)
module SimPhone {
    //! The phone's whole workout, the events it applied, its rest and the rest's stamp.
    var phone = null;
    var applied = [];
    var rest = null;
    var restAt = null;

    //! The first snapshot, as the bridge hands it over.
    function first(snap) {
        return copy(snap);
    }

    function begin() as Void {
        phone = SimData.phone();
        if (phone.size() == 0) {
            phone = null;
        } else {
            Workout.begin();
        }
    }

    //! Every 2 s (Sim.mem).
    function turn() as Void {
        phoneTurn();
    }

    //! The watch's events the phone has not applied yet, applied; and its snapshot back when any were.
    function phoneTurn() as Void {
        var ob = G.state["ob"];
        var any = false;
        for (var i = 0; i < ob.size(); i += 1) {
            var ev = Core.unpack(ob[i]);
            var id = ev["id"];
            if (Core.inArr(applied, id)) {
                continue;
            }
            applied.add(id);
            any = true;
            var t = ev["type"];
            if (Core.same(t, "setDone")) {
                phoneTick(ev);
            } else if (Core.same(t, "rest")) {
                rest = ev["endsAt"];
                restAt = ev["at"];
            } else if (Core.same(t, "start")) {
                phoneStart(ev);
            } else if (Core.same(t, "finish") || Core.same(t, "discard")) {
                phone = null;
            }
        }
        if (applied.size() > 40) {
            applied = applied.slice(applied.size() - 40, null);
        }
        if (any) {
            System.println("phone: snapshot, " + G.state["ob"].size() + " in the outbox");
            (Application.getApp() as OpenGymApp).took(snapshot());
        }
    }

    //! Started on the watch: the phone builds today's routine (every row with its id) under the watch's id.
    function phoneStart(ev) as Void {
        var today = SimData.snapshot()["ready"]["today"];
        var es = today["entries"];
        for (var i = 0; i < es.size(); i += 1) {
            es[i]["i"] = i;
            var rows = es[i]["sets"];
            for (var j = 0; j < rows.size(); j += 1) { rows[j]["sid"] = "sw" + i + "x" + j; }
        }
        phone = { "id" => ev["wid"], "name" => today["name"], "start" => ev["at"], "unit" => "kg", "cur" => 0, "restSec" => 90, "entries" => es };
        rest = null;
        restAt = null;
    }

    function phoneTick(ev) as Void {
        if (phone == null) {
            return;
        }
        var es = phone["entries"];
        var ei = Core.toI(ev["entryIdx"], -1);
        var si = Core.toI(ev["setIdx"], -1);
        if (ei < 0 || ei >= es.size() || si < 0 || si >= es[ei]["sets"].size()) {
            return;
        }
        var row = es[ei]["sets"][si];
        var side = ev["side"];
        if (side != null && row["sides"] != null) {
            Core.markSide(row, side, ev["w"], ev["r"], ev["at"]);
        } else {
            row["done"] = true;
            if (ev["w"] != null) { row["w"] = ev["w"]; }
            if (ev["r"] != null) { row["r"] = ev["r"]; }
            if (ev["sec"] != null) { row["sec"] = ev["sec"]; }
            row["at"] = ev["at"];
        }
        var end = ev["restEnd"];
        if (end != null) {
            rest = end == 0 ? null : end;
            restAt = ev["at"];
        }
    }

    //! The phone's snapshot: lib/garmin-snapshot.js's window over its copy of the workout.
    function snapshot() as Dictionary {
        var out = SimData.snapshot();
        out["acked"] = applied.size() > 16 ? applied.slice(applied.size() - 16, null) : applied;
        out["now"] = Core.nowMs();
        if (phone == null) {
            out["active"] = null;
            return out;
        }
        var es = phone["entries"];
        var a = {};
        var keys = phone.keys();
        for (var k = 0; k < keys.size(); k += 1) {
            if (!Core.same(keys[k], "entries")) { a[keys[k]] = phone[keys[k]]; }
        }
        var win = [];
        var idx = window(es, Core.toI(phone["cur"], 0));
        for (var j = 0; j < idx.size(); j += 1) {
            win.add(copy(es[idx[j]]));
        }
        a["entries"] = win;
        a["count"] = es.size();
        if (rest != null) { a["rest"] = { "endsAt" => rest }; } else { a.remove("rest"); }
        if (restAt != null) { a["restAt"] = restAt; }
        out["active"] = a;
        return out;
    }

    function open(e) as Boolean {
        if (Core.isCardio(e)) {
            return false;
        }
        var sets = e["sets"];
        for (var i = 0; i < sets.size(); i += 1) {
            if (!Core.isTrue(sets[i]["done"])) { return true; }
        }
        return false;
    }

    //! garminWindow: the exercise up now (from cur, the first with a set to do), its superset, the block after.
    function window(es, cur) as Array {
        var n = es.size();
        var at = -1;
        for (var k = 0; k < n && at < 0; k += 1) {
            var i = (cur + k) % n;
            if (open(es[i])) { at = i; }
        }
        if (at < 0) { at = cur; }
        var b = block(es, at);
        var out = [];
        for (var i2 = b[0]; i2 <= b[1]; i2 += 1) { out.add(i2); }
        if (b[1] + 1 < n) {
            var b2 = block(es, b[1] + 1);
            for (var i3 = b2[0]; i3 <= b2[1]; i3 += 1) { out.add(i3); }
        }
        return out;
    }

    function block(es, at) as Array {
        var lo = at;
        var hi = at;
        var g = es[at]["group"];
        if (g != null) {
            while (lo > 0 && Core.same(es[lo - 1]["group"], g)) { lo -= 1; }
            while (hi + 1 < es.size() && Core.same(es[hi + 1]["group"], g)) { hi += 1; }
        }
        return [lo, hi];
    }

    function copy(v) {
        if (v instanceof Lang.Dictionary) {
            var out = {};
            var ks = v.keys();
            for (var i = 0; i < ks.size(); i += 1) { out[ks[i]] = copy(v[ks[i]]); }
            return out;
        }
        if (v instanceof Lang.Array) {
            var o = [];
            for (var j = 0; j < v.size(); j += 1) { o.add(copy(v[j])); }
            return o;
        }
        // as the Android bridge hands them over: a number with a fraction is a Java Double
        if (v instanceof Lang.Float) {
            return v.toDouble();
        }
        return v;
    }
}
