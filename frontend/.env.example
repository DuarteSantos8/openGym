# Firebase mode (Phase 2): copy these into the build environment (or a local .env) and
# build with VITE_FIREBASE=1. Values come from the Firebase console:
# Project settings → General → "Your apps" → the web app's firebaseConfig object.
# They are project identifiers, not secrets: Firestore rules guard the data.
VITE_FIREBASE=1
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
