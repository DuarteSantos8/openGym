<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The workout service: heart rate while it runs, the rest's buzz with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Heart rate through Health Services: the body sensor up to Wear OS 5, the health
         permission from Wear OS 6 (API 36) on. Only asked for when a workout starts. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Health Services' calories (CALORIES_TOTAL) need it; without it the workout still measures the heart rate. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Now playing (MediaControls.kt): the system's Media Controls app, one tap away. -->
    <queries>
        <package android:name="com.google.android.wearable.media.sessions" />
        <package android:name="com.samsung.android.wearable.mediacontroller" />
        <package android:name="com.samsung.android.watch.mediacontroller" />
        <package android:name="com.mobvoi.ticwear.media" />
        <intent>
            <action android:name="com.google.android.wearable.action.MEDIA_CONTROLS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenGymWear">

        <uses-library android:name="com.google.android.wearable" android:required="false" />

        <!-- Paired with the phone app, which stays the source of truth: no standalone mode. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.OpenGymWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keep going, from the "Still training?" notification (IdleNotice.kt). -->
        <receiver
            android:name=".IdleNoticeReceiver"
            android:exported="false" />

        <!-- The running workout: heart rate (Health Services), the rest timer and its buzz, the
             ongoing activity on the watch face. Runs only while a workout runs. -->
        <service
            android:name=".WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- What the phone sends: the workout snapshot and the exercises' stills (data items) and "open the app" (a message).
             And the watch's own events (/opengym/event/): the phone deletes each once it has stored
             it, and that deletion is how the watch knows it arrived (PhoneLink.delivered). Without
             the path here the deletions never reached this service. -->
        <service
            android:name=".WearListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/opengym/snapshot" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/opengym/still/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/opengym/event/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/opengym/open" />
            </intent-filter>
        </service>

        <!-- The Tile: the streak and today's plan, or the set up next while a workout runs. -->
        <service
            android:name=".OpenGymTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
            <meta-data
                android:name="com.google.android.clockwork.tiles.PROVIDER_CONFIG_DESCRIPTION"
                android:resource="@string/tile_desc" />
        </service>

        <!-- The complication: sets done of the workout as a ring, else the week streak. -->
        <service
            android:name=".ProgressComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_barbell"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,MONOCHROMATIC_IMAGE" />
            <!-- Pushed by the app whenever it changes; this is only the fallback. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>
    </application>
</manifest>
