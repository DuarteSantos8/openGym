<?xml version="1.0" encoding="utf-8" ?>
<!-- Only with -PplayWithoutBackgroundLocation (app/build.gradle): the Play build without
     background location, should Google Play refuse its declaration for the gym reminder. It takes
     the place of src/play/AndroidManifest.xml, so the Huawei lines are here too. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <application>
        <!-- Huawei's Wear Engine SDK (HuaweiLink, src/hms): its app id (-PhuaweiAppId in app/huawei.gradle;
             empty: the link says "build"). The SDK's own manifest brings the <queries> entry for Huawei Health. -->
        <meta-data android:name="com.huawei.hms.client.appid" android:value="${huaweiAppId}" />
    </application>
</manifest>
