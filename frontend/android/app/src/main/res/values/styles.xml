<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Draw into the camera cutout like iOS does under the notch: the WebView then reports a
             real env(safe-area-inset-top) and the sheets keep clear of it (the sat variable in index.css). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ draws its own splash first: the icon on the brand's dark, like drawable/splash
             after it, instead of the system's white in light mode. -->
        <item name="windowSplashScreenBackground">#FF0C0E12</item>
    </style>

    <!-- The accent laid over the theme at start and on every change (AccentTheme.java, #980):
         selection handles, the native caret and a native field's highlight. -->
    <style name="Accent.Brand" parent="">
        <item name="colorAccent">#a3e635</item>
        <item name="colorControlActivated">#a3e635</item>
        <item name="android:colorAccent">#a3e635</item>
        <item name="android:colorControlActivated">#a3e635</item>
        <item name="android:textColorHighlight">#66a3e635</item>
