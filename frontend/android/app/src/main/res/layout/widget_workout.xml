<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_widget_card">

    <!-- Themed Background Layer with Repeating Athletic SVG Pattern -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- Content Padding Wrapper -->
    <FrameLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

    <!-- ==================== 1. ACTIVE WORKOUT STATE ==================== -->
    <LinearLayout
        android:id="@+id/widget_layout_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header: Eyebrow + Exercise/Set Capsule Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_active_gym_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_gym_dumbbell" />

            <TextView
                android:id="@+id/widget_active_eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVE WORKOUT"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/widget_active_set_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="EX 1/5 · SET 1/3"
                android:textColor="#30D158"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Exercise Title -->
        <TextView
            android:id="@+id/widget_active_exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dumbbell Bench Press"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Target Subtitle -->
        <TextView
            android:id="@+id/widget_active_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: 10 lb × 15 reps"
            android:textColor="#9E9EA5"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginTop="1dp" />

        <!-- Steppers Row (In-App .stp 10dp Rounded Rect Controls) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <!-- Weight Stepper Rect -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stepper_rect">

                <TextView
                    android:id="@+id/widget_btn_weight_minus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_touch"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_text_weight_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="10 lb"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_btn_weight_plus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_touch"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Reps Stepper Rect -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stepper_rect">

                <TextView
                    android:id="@+id/widget_btn_reps_minus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_touch"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_text_reps_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="15 reps"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_btn_reps_plus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_touch"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top spacer — pushes bar into vertical center of the free space -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Progress Track (5dp, ~90% width, centered with 16dp side margins) -->
        <ImageView
            android:id="@+id/widget_active_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitXY" />

        <!-- Bottom spacer — equal to top spacer, pinning CTA to bottom -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Complete Set CTA Button (44dp Height, No Tick, 16sp Bold) -->
        <FrameLayout
            android:id="@+id/widget_btn_log_container"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/widget_btn_log_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_btn_log_accent" />

            <TextView
                android:id="@+id/widget_btn_log_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Complete Set"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== 2. REST TIMER STATE ==================== -->
    <LinearLayout
        android:id="@+id/widget_layout_rest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header: REST TIMER badge + Upcoming set info badge -->
        <!-- Top Header: REST TIMER badge + Upcoming set info badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_rest_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="● REST TIMER"
                android:textColor="#30D158"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/widget_rest_next_set_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="EX 1/5 · SET 2/3"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Countdown block — spacer above centers it in top zone -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Countdown timer (38sp, centered) -->
        <TextView
            android:id="@+id/widget_rest_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01:30"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02" />

        <!-- Progress Track: edge-to-edge, 5dp high -->
        <ImageView
            android:id="@+id/widget_rest_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY" />

        <!-- Equal spacer between progress and subtext -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Main Text: Up Next Exercise (15sp, bold, centered) -->
        <TextView
            android:id="@+id/widget_rest_next_exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Next: Dumbbell Bench Press"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Subtext: Set & Target Details (13sp, muted, centered) -->
        <TextView
            android:id="@+id/widget_rest_next_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Set 2/3 · 10 lb × 15 reps"
            android:textColor="#9E9EA5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:singleLine="true" />

        <!-- Equal spacer between subtext and action buttons -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Rest Action Buttons (44dp Height, 16sp Bold) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/widget_btn_rest_plus_15_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_rest_plus_15_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_dark" />

                <TextView
                    android:id="@+id/widget_btn_rest_plus_15"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+15s"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_rest_skip_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_rest_skip_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_dark" />

                <TextView
                    android:id="@+id/widget_btn_rest_skip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Skip Rest"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 3. WORKOUT COMPLETE STATE ==================== -->
    <LinearLayout
        android:id="@+id/widget_layout_complete"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OPENGYM"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ DONE"
                android:textColor="#30D158"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_complete_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout Complete! 🎉"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/widget_complete_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All sets completed. Tap below to review."
            android:textColor="#9E9EA5"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_btn_finish_review_container"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/widget_btn_finish_review_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_btn_log_accent" />

            <TextView
                android:id="@+id/widget_btn_finish_review"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Finish &amp; Review"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== 4. STANDBY STATE (APPLE FITNESS / MINIMAL) ==================== -->
    <LinearLayout
        android:id="@+id/widget_layout_standby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Standby Header: Minimal Greeting Eyebrow + Reminder Pill + Status Capsule Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_standby_gym_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_gym_dumbbell" />

            <TextView
                android:id="@+id/widget_standby_eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GOOD MORNING"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/widget_standby_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:text="🔔 08:00"
                android:textColor="#FF9F0A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_standby_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="COMPLETED"
                android:textColor="#30D158"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Title (Routine Name or Milestone) -->
        <TextView
            android:id="@+id/widget_standby_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chest Tricep"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <!-- Apple Fitness Metric Columns -->
        <LinearLayout
            android:id="@+id/widget_standby_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <!-- Stat 1: Sets -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_standby_stat1_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_standby_stat1_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Stat 2: Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_standby_stat2_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5,138"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_standby_stat2_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUME (LB)"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Stat 3: Duration / Recovery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_standby_stat3_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="62m"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_standby_stat3_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Secondary detail line -->
        <TextView
            android:id="@+id/widget_standby_last_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Great session logged today"
            android:textColor="#9E9EA5"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Responsive spacer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Start Workout CTA Button (42dp Height) -->
        <FrameLayout
            android:id="@+id/widget_btn_start_container"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/widget_btn_start_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_btn_log_accent" />

            <TextView
                android:id="@+id/widget_btn_start_workout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="▶  Start Workout"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </FrameLayout>
    </LinearLayout>

    </FrameLayout>
</FrameLayout>
