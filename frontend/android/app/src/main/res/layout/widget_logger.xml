<?xml version="1.0" encoding="utf-8"?>
<!-- The widget while a workout runs (OpenGymWidgetProvider.shape, WidgetLogger): the set to do now,
     its weight and reps (or seconds) with − and +, and Log set. 2x2 and wider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/lg_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lg_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_2"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/lg_row_w"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lg_w_minus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_w"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_w_plus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lg_row_r"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lg_r_minus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_r"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_r_plus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lg_row_s"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lg_s_minus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_s"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lg_s_plus"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lg_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_btn"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
