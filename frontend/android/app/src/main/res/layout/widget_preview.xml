<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (opengym_widget_info.xml previewLayout, Android 12+): the 4x2
     widget with made-up numbers, a streak and this week, so the picker shows what it does
     instead of an empty box. Never drawn on the home screen; widget_medium.xml is the real one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_flame" />

            <TextView
            android:text="@string/widget_kind_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:text="12"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="bottom|start"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The line between the two. A FrameLayout, not a View: a widget may only hold the classes
         RemoteViews allows, and a plain View made the launcher say "Unable to load widget" as
         soon as the widget was stretched to this size (#981). -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_calendar" />

            <TextView
            android:text="@string/widget_kind_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:text="3 / 4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="bottom|start"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text_2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
