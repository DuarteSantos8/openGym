<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The in-app updater (InstallPlugin) hands the downloaded APK to the system installer.
         Only in this build: Google Play updates the Play build itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <!-- Huawei's Wear Engine SDK (HuaweiLink, src/hms): its app id (-PhuaweiAppId in app/huawei.gradle;
             empty: the link says "build"). The SDK's own manifest brings the <queries> entry for Huawei Health. -->
        <meta-data android:name="com.huawei.hms.client.appid" android:value="${huaweiAppId}" />
    </application>
</manifest>
