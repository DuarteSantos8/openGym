# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;
    resolver ${RESOLVER} valid=10s ipv6=off;
    # Resolve the optional MCP service only when one of its routes is requested. A literal
    # proxy_pass makes nginx resolve `mcp` while loading the config, which prevents web-only
    # startup when the optional gateway is not part of the stack.
    set $mcp_upstream http://mcp:8787;

    # Sent on every response below. NOTE: an `add_header` inside a location replaces the whole
    # inherited set rather than adding to it, so the two locations further down that set their
    # own Cache-Control have to repeat these three. Deliberately not a full Content-Security-
    # Policy: only frame-ancestors, which no part of the app depends on. TLS, HSTS and any
    # stricter policy stay the reverse proxy's job (see SECURITY.md).
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # API → backend container.
    # `^~` so this prefix beats the regex locations below: without it a request for a path such
    # as /api/anything.json would be matched by the \.(js|css|json|html)$ block instead and be
    # looked for on disk rather than proxied.
    location ^~ /api/ {
        # Match the API's own body limit (MAX_BODY in api/server.js): the whole workout history
        # travels in one PUT /api/data, and nginx's 1 MiB default would answer 413 here before the
        # API ever saw it — a sync that silently stops once the history grows past 1 MiB.
        client_max_body_size 16m;
        # Resolved per request through the container runtime's DNS, not once at start-up: nginx
        # otherwise pins the api container's IP when it boots, and a recreated api (new IP) means
        # 502 on every /api call until web is restarted too (issue #16). The variable is what makes
        # nginx re-resolve; lowercase so the entrypoint's envsubst leaves it alone.
        #
        # RESOLVER defaults to Docker's embedded DNS, which is where this image usually runs.
        # Nothing answers on that address outside Docker, and an unreachable resolver does not
        # fail fast — every /api request hangs until it times out. Anywhere else, set RESOLVER to
        # the DNS the platform actually provides: on Kubernetes that is the kube-dns/CoreDNS
        # service address (`kubectl -n kube-system get svc kube-dns`, commonly 10.96.0.10).
        set $api_upstream http://${BACKEND}:${PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # DCR registrations are also reachable under /api. Overwrite the
        # gateway-owned source header here so a direct browser cannot choose a
        # fresh limiter bucket on every request.
        proxy_set_header X-OpenGym-Client-IP $remote_addr;
        # $remote_addr, NOT $proxy_add_x_forwarded_for: the latter APPENDS to whatever the client
        # sent, and the API reads the first entry — so a client could put any address it liked in
        # front of its own and choose what the activity log recorded about it. Overwriting is what
        # makes the header mean anything.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same reasoning, and the API trusts this one FIRST. Empty by default, which drops the
        # header entirely, so a direct client cannot forge it. Cloudflare users set
        # CF_CONNECTING_IP=$http_cf_connecting_ip to let the real one through — correct only when
        # Cloudflare is genuinely in front, because that is what overwrites a client-supplied one.
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
    }

    # MCP discovery is served by the gateway as well. Keep these exact routes ahead of the SPA
    # fallback so clients do not receive index.html for a well-known metadata request.
    location = /.well-known/oauth-protected-resource {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /.well-known/oauth-authorization-server {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth 2.1 PKCE endpoints are handled by the MCP gateway. The authorize page relies on the
    # signed openGym session cookie, which nginx forwards unchanged; no bearer or client secret is
    # minted at this edge.
    location ^~ /oauth {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        # DCR source limiting uses this gateway-owned value. Never pass through
        # caller-controlled forwarding headers to the MCP/API hop.
        proxy_set_header X-OpenGym-Client-IP $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Remote MCP gateway. The gateway has no profile-data mount; it calls the API with a scoped
    # grant. Keeping it on this origin preserves the existing Coolify/Traefik routing and passkey
    # host while avoiding a second public hostname.
    location ^~ /mcp {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
