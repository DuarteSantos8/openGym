        "customEx": {
          "x": {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "at": 1
            }
          }
        }
      },
      "expect": []
    },
