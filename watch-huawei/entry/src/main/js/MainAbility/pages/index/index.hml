<!-- One page, every screen a block shown by `if` on one value (view.js decides which): the lite
     router can only replace a page, and a replaced page loses its state. Accent colours are bound as
     single values inside a declaration, the form the docs show (style="color: {{x}};"). -->
<div class="root" onswipe="swipe">

  <!-- The stored workout could not be read: nothing was changed, nothing is saved -->
  <div class="scr" if="{{s_lost}}">
    <text class="wrap">{{lostText}}</text>
    <input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{retryLabel}}" onclick="retry" />
  </div>

  <!-- Start -->
  <div class="scr" if="{{s_idle}}">
    <text class="small quiet">{{title}}</text>
    <text class="nameBig">{{name}}</text>
    <text class="tiny quiet">{{plan}}</text>
    <text class="hint">{{hint}}</text>
    <input if="{{canStart}}" type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{startLabel}}" onclick="start" />
    <input elif="{{showStart}}" type="button" class="btn" value="{{startLabel}}" />
    <input if="{{showRoutines}}" type="button" class="btn" value="{{routinesLabel}}" onclick="routines" />
    <text class="tiny quiet">{{top}}</text>
  </div>

  <!-- Routines, three a page -->
  <div class="scr" if="{{s_routines}}">
    <div class="pick" if="{{rv0}}" onclick="pick0"><text class="rName">{{ro0}}</text><text class="rSub" style="color: {{accent}};">{{rs0}}</text></div>
    <div class="pick" if="{{rv1}}" onclick="pick1"><text class="rName">{{ro1}}</text><text class="rSub" style="color: {{accent}};">{{rs1}}</text></div>
    <div class="pick" if="{{rv2}}" onclick="pick2"><text class="rName">{{ro2}}</text><text class="rSub" style="color: {{accent}};">{{rs2}}</text></div>
    <div class="row2">
      <input type="button" class="arrow" value="X" onclick="rback" />
      <input if="{{rPaged}}" type="button" class="arrow" value="{{gt}}" onclick="rnext" />
    </div>
  </div>

  <!-- 3-2-1 (also before a hold); a tap on the number starts at once -->
  <div class="scr" if="{{s_count}}">
    <text class="small quiet">{{label}}</text>
    <stack class="cRing">
      <progress type="arc" class="cArc" percent="{{pct}}" style="color: {{accent}};"></progress>
      <div class="cIn" onclick="skipCount"><text if="{{goOn}}" class="cGo" style="color: {{accent}};">{{big}}</text><text else class="cNum" style="color: {{accent}};">{{big}}</text></div>
    </stack>
    <div class="rowX"><input type="button" class="arrow" value="X" onclick="cancelCount" /></div>
  </div>

  <!-- Waiting for the phone -->
  <div class="scr" if="{{s_wait}}">
    <div class="barS">
      <input type="button" class="menuS" value="{{menuLabel}}" onclick="menu" />
      <text class="topR">{{top}}</text>
    </div>
    <text class="nameBig">{{name}}</text>
    <text class="waitTx">{{body}}</text>
  </div>

  <!-- Still training? -->
  <div class="scr" if="{{s_ask}}">
    <text class="mid">{{title}}</text>
    <text class="wrap">{{body}}</text>
    <input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{keepLabel}}" onclick="keep" />
    <input type="button" class="btn" value="{{finishLabel}}" onclick="askFinish" />
  </div>

  <!-- Finish and Discard ask first -->
  <div class="scr" if="{{s_confirm}}">
    <text class="mid">{{title}}</text>
    <input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{noLabel}}" onclick="no" />
    <input type="button" class="btnO" style="border-color: {{yesColor}}; color: {{yesColor}};" value="{{yesLabel}}" onclick="yes" />
  </div>

  <!-- The workout menu: a list, it scrolls -->
  <div class="scr" if="{{s_menu}}">
    <list class="menuList">
      <list-item class="li" if="{{hasPrev}}"><div class="liIn"><input type="button" class="btn" value="{{lPrev}}" onclick="mPrev" /></div></list-item>
      <list-item class="li" if="{{hasOver}}"><div class="liIn"><input type="button" class="btn" value="{{lOver}}" onclick="mOver" /></div></list-item>
      <list-item class="li" if="{{hasSkip}}"><div class="liIn"><input type="button" class="btn" value="{{lSkip}}" onclick="mSkip" /></div></list-item>
      <list-item class="li" if="{{hasNext}}"><div class="liIn"><input type="button" class="btn" value="{{lNext}}" onclick="mNext" /></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="btn" value="{{lFinish}}" onclick="mFinish" /></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="btnR" value="{{lDiscard}}" onclick="mDiscard" /></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{lBack}}" onclick="mBack" /></div></list-item>
    </list>
  </div>

  <!-- A hold -->
  <div class="scr" if="{{s_hold}}">
    <text class="hrC">{{top}}</text>
    <text class="mid">{{name}}</text>
    <text class="tiny quiet">{{tag}}</text>
    <text class="hero" style="color: {{timeColor}};">{{time}}</text>
    <progress type="horizontal" class="holdBar" percent="{{pct}}" style="color: {{accent}};"></progress>
    <input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{stopLabel}}" onclick="stopHold" />
    <text class="syncLn">{{sync}}</text>
  </div>

  <!-- The set, as the Apple Watch's: the pill (it opens the menu; Cancel while a set is fixed) and the heart rate on
       top, the name, the weight and reps tiles, Last time, then ‹ Done › (Save while fixing). -->
  <div class="scr" if="{{s_set}}">
    <div class="barS">
      <input if="{{fixing}}" type="button" class="pill" value="{{cancelLabel}}" onclick="cancelFix" />
      <input else type="button" class="pill" value="{{pill}}" onclick="menu" />
      <text class="hrSet">{{top}}</text>
    </div>
    <text class="name">{{name}}</text>
    <text class="tiny quiet">{{tag}}</text>
    <div class="subRow">
      <text class="partnerT" if="{{partnerOn}}" style="color: {{accent}};">{{partner}}</text>
    </div>
    <div class="tiles">
      <div class="tile" if="{{wOn}}">
        <text class="tLabel" style="color: {{accent}};">{{wLabel}}</text>
        <div class="numRow">
          <text class="numT">{{wNum}}</text>
          <text class="unitT" style="color: {{accent}};">{{wUnit}}</text>
        </div>
        <div class="steps">
          <input type="button" class="step" value="-" onclick="wMinus" />
          <input type="button" class="step" value="+" onclick="wPlus" />
        </div>
      </div>
      <div class="tile">
        <text class="tLabel" style="color: {{accent}};">{{rLabel}}</text>
        <text class="numC">{{rNum}}</text>
        <div class="steps">
          <input type="button" class="step" value="-" onclick="rMinus" />
          <input type="button" class="step" value="+" onclick="rPlus" />
        </div>
      </div>
    </div>
    <text class="tiny quiet">{{last}}</text>
    <div class="doneRow">
      <input if="{{prevOn}}" type="button" class="arrow" value="{{lt}}" onclick="prev" />
      <input else type="button" class="arrowOff" value="{{lt}}" />
      <input if="{{locked}}" type="button" class="doneOff" value="{{doneLabel}}" />
      <input else type="button" class="done" style="background-color: {{accent}}; color: {{ink}};" value="{{doneLabel}}" onclick="done" />
      <input if="{{nextOn}}" type="button" class="arrow" value="{{gt}}" onclick="nextFix" />
      <input else type="button" class="arrowOff" value="{{gt}}" />
    </div>
  </div>

  <!-- The rest, as the Apple Watch's: the heart rate on top, the time, a draining bar, -15 / Skip / +15, the rating (the
       chips, or the one it got) with Up next under it, the sync state at the foot. -->
  <div class="scr" if="{{s_rest}}">
    <div class="bar">
      <input type="button" class="menuS" value="{{menuLabel}}" onclick="menu" />
      <text class="hrTop">{{top}}</text>
    </div>
    <text class="big" style="color: {{timeColor}};">{{restTime}}</text>
    <div class="slot">
      <progress if="{{barOn}}" type="horizontal" class="restBar" percent="{{pct}}" style="color: {{accent}};"></progress>
      <text class="tiny quiet" else>{{restLabel}}</text>
    </div>
    <div class="row3">
      <input if="{{locked}}" type="button" class="capOff" value="-15" />
      <input else type="button" class="cap" value="-15" onclick="restMinus" />
      <input if="{{locked}}" type="button" class="capMidOff" value="{{skipLabel}}" />
      <input else type="button" class="capMid" value="{{skipLabel}}" onclick="restSkip" />
      <input if="{{locked}}" type="button" class="capOff" value="+15" />
      <input else type="button" class="cap" value="+15" onclick="restPlus" />
    </div>
    <div class="rate" if="{{rateOn}}">
      <text class="tiny quiet">{{rateLn}}</text>
      <div class="row4" if="{{effortOn}}">
        <input type="button" class="chipR" style="border-color: {{cc0}}; color: {{cc0}};" value="{{c0}}" onclick="chip0" />
        <input type="button" class="chipR" style="border-color: {{cc1}}; color: {{cc1}};" value="{{c1}}" onclick="chip1" />
        <input type="button" class="chipR" style="border-color: {{cc2}}; color: {{cc2}};" value="{{c2}}" onclick="chip2" />
        <input type="button" class="chipR" style="border-color: {{cc3}}; color: {{cc3}};" value="{{c3}}" onclick="chip3" />
      </div>
      <div class="rated" else style="border-color: {{ratedColor}};">
        <text class="ratedTx" style="color: {{ratedColor}};">{{ratedText}}</text>
      </div>
    </div>
    <div class="upOne" if="{{effortOn}}">
      <text class="upL" style="color: {{accent}};">{{upNext}}</text>
      <text class="upR">{{nextNums}}</text>
    </div>
    <div class="up" else>
      <text class="tiny" style="color: {{accent}};">{{upNext}}</text>
      <text class="tiny">{{nextName}}</text>
      <text class="tiny quiet">{{nextNums}}</text>
    </div>
    <text class="syncLn">{{sync}}</text>
  </div>

  <!-- Overview: a list, it scrolls -->
  <div class="scr" if="{{s_over}}">
    <text class="small">{{title}}</text>
    <text class="tiny quiet">{{count}}</text>
    <list class="overList">
      <list-item class="li" if="{{ss0}}"><div class="liIn"><text class="tiny quiet">{{ssLabel}}</text></div></list-item>
      <list-item class="li" if="{{ovv0}}"><div class="liIn"><div class="orow" style="border-color: {{ol0}};" onclick="ov0"><div class="omark" style="background-color: {{ob0}};"></div><div class="ocol"><text class="oName">{{on0}}</text><text class="oCnt">{{oc0}}</text></div></div></div></list-item>
      <list-item class="li" if="{{ss1}}"><div class="liIn"><text class="tiny quiet">{{ssLabel}}</text></div></list-item>
      <list-item class="li" if="{{ovv1}}"><div class="liIn"><div class="orow" style="border-color: {{ol1}};" onclick="ov1"><div class="omark" style="background-color: {{ob1}};"></div><div class="ocol"><text class="oName">{{on1}}</text><text class="oCnt">{{oc1}}</text></div></div></div></list-item>
      <list-item class="li" if="{{ss2}}"><div class="liIn"><text class="tiny quiet">{{ssLabel}}</text></div></list-item>
      <list-item class="li" if="{{ovv2}}"><div class="liIn"><div class="orow" style="border-color: {{ol2}};" onclick="ov2"><div class="omark" style="background-color: {{ob2}};"></div><div class="ocol"><text class="oName">{{on2}}</text><text class="oCnt">{{oc2}}</text></div></div></div></list-item>
      <list-item class="li" if="{{ss3}}"><div class="liIn"><text class="tiny quiet">{{ssLabel}}</text></div></list-item>
      <list-item class="li" if="{{ovv3}}"><div class="liIn"><div class="orow" style="border-color: {{ol3}};" onclick="ov3"><div class="omark" style="background-color: {{ob3}};"></div><div class="ocol"><text class="oName">{{on3}}</text><text class="oCnt">{{oc3}}</text></div></div></div></list-item>
      <list-item class="li" if="{{ovPaged}}"><div class="liIn"><input type="button" class="btn" value="{{gt}}" onclick="ovNext" /></div></list-item>
      <list-item class="li" if="{{ovMoreOn}}"><div class="liIn"><text class="tiny quiet">{{ovMore}}</text></div></list-item>
      <list-item class="li"><div class="liIn"><text class="tiny quiet">{{sync}}</text></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="btnA" style="background-color: {{accent}}; color: {{ink}};" value="{{finishLabel}}" onclick="finish" /></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="btn" value="{{backLabel}}" onclick="ovBack" /></div></list-item>
    </list>
  </div>

  <!-- All sets done -->
  <div class="scr" if="{{s_end}}">
    <div class="barS">
      <input type="button" class="menuS" value="{{menuLabel}}" onclick="menu" />
      <text class="topR">{{top}}</text>
    </div>
    <text class="mid">{{title}}</text>
    <text class="small quiet">{{count}}</text>
    <text class="tiny quiet">{{sync}}</text>
    <input type="button" class="wide" style="background-color: {{accent}}; color: {{ink}};" value="{{finishLabel}}" onclick="finish" />
  </div>

  <!-- Cardio, or a timed exercise with nothing left -->
  <div class="scr" if="{{s_card}}">
    <div class="barS">
      <input type="button" class="menuS" value="{{menuLabel}}" onclick="menu" />
      <text class="topR">{{top}}</text>
    </div>
    <text class="mid">{{name}}</text>
    <text class="wrap">{{body}}</text>
    <input type="button" class="wide" style="background-color: {{accent}}; color: {{ink}};" value="{{nextLabel}}" onclick="nextEx" />
  </div>

  <!-- Summary: a list -->
  <div class="scr" if="{{s_summary}}">
    <list class="sumList" ref="sum">
      <list-item class="liT"><div class="liTi"><div class="tRow"><div class="tick" style="background-color: {{accent}};"></div><text class="sTitle">{{title}}</text></div><text class="sName">{{name}}</text></div></list-item>
      <list-item class="liD"><div class="liDi"><text class="tinyL quiet">{{durLabel}}</text><text class="bigY">{{dur}}</text></div></list-item>
      <list-item class="li"><div class="liIn"><div class="row2s">
        <div class="colL"><text class="tinyL quiet">{{setsLabel}}</text><text class="midL">{{setsNum}}</text></div>
        <div class="colL"><text class="tinyL quiet">{{volLabel}}</text><text class="midL">{{volNum}}</text></div>
      </div></div></list-item>
      <list-item class="liS" if="{{hrOn}}"><div class="liSi"><text class="tinyC quiet">{{hrLine}}</text></div></list-item>
      <list-item class="liS" if="{{syncOn}}"><div class="liSi"><text class="tinyC quiet">{{sync}}</text></div></list-item>
      <list-item class="li"><div class="liIn"><input type="button" class="done" style="background-color: {{accent}}; color: {{ink}};" value="{{doneLabel}}" onclick="close" /></div></list-item>
    </list>
  </div>


  <!-- Metrics: time, sets, volume, heart rate -->
  <div class="scr" if="{{s_mnum}}">
    <div class="mbar"><input type="button" class="arrow" value="{{lt}}" onclick="mpBack" /></div>
    <text class="bigY">{{mTime}}</text>
    <text class="tinyL quiet">{{mSub}}</text>
    <text class="midR">{{mHr}}</text>
    <text class="tinyL quiet">{{hrLine}}</text>
    <div class="row2s">
      <div class="colL"><text class="tinyL quiet">{{setsLabel}}</text><text class="midL">{{setsNum}}</text></div>
      <div class="colL"><text class="tinyL quiet">{{volLabel}}</text><text class="midL">{{volNum}}</text></div>
    </div>
  </div>


</div>
