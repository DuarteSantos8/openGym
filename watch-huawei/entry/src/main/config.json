{
  "app": {
    "bundleName": "ch.duartesantos.opengym.huawei",
    "vendor": "openGym",
    "version": { "code": 1004006, "name": "1.4.6" }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": ["liteWearable"],
    "distro": { "deliveryWithInstall": true, "moduleName": "entry", "moduleType": "entry" },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "reqPermissions": [
      { "name": "ohos.permission.VIBRATE" },
      {
        "name": "ohos.permission.READ_HEALTH_DATA",
        "reason": "$string:hr_reason",
        "usedScene": { "ability": [".MainAbility"], "when": "inuse" }
      }
    ],
    "metaData": {
      "customizeData": [
        { "name": "supportLists", "value": "ch.duartesantos.opengym:REPLACE_WITH_SHA256_OF_SIGNING_CERT", "extra": "" }
      ]
    },
    "js": [
      { "pages": ["pages/index/index"], "name": ".MainAbility" }
    ]
  }
}
