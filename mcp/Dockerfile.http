# The optional remote MCP server (`mcp` compose profile, docs/MCP_REMOTE.md). Built from the repo
# root: the tools import the frontend's pure lib/ helpers and the api's state-store.js, so those
# come along as source. The stdio bridge needs no image.
FROM node:22-alpine
WORKDIR /app
COPY mcp/package.json mcp/package-lock.json ./mcp/
RUN cd mcp && npm ci --omit=dev
COPY mcp/src ./mcp/src
COPY api/state-store.js ./api/state-store.js
COPY frontend/src ./frontend/src
ENV PORT=3001 HOST=0.0.0.0 OPENGYM_DATA=/data OAUTH_DATA=/oauth-data
EXPOSE 3001
HEALTHCHECK --interval=1m --timeout=5s --retries=3 CMD wget --spider -q http://127.0.0.1:3001/health || exit 1
CMD ["node", "mcp/src/http.js"]
